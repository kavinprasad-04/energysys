# ---------------------------------------------------------------------------
# EnergySYS Service Report — server configuration
# Copy this file to  server/.env  and fill in real values.
# NEVER commit server/.env (it is git-ignored).
# ---------------------------------------------------------------------------

# --- App ---
PORT=3000

# --- Where every report is emailed ---
# Fixed recipient (the form has no recipient field, only an optional CC box).
REPORT_TO=rds@esys.co.in
ENQUIRY_TO=rds@esys.co.in   # where the website contact form emails enquiries
QUERY_RECEIVER_EMAIL=rds@esys.co.in   # POST /api/send-query recipient
MAX_ATTACHMENT_MB=10

# --- SMTP / Nodemailer : send from the Gmail account above ---
# 1. Turn on 2-Step Verification on that Google account.
# 2. Google Account -> Security -> App passwords -> create one for "Mail".
# 3. Paste the 16-character app password (no spaces) as EMAIL_PASSWORD below.
# Until EMAIL_PASSWORD is set, the server routes mail to a free Ethereal test
# inbox and returns a preview URL, so you can trial the workflow first.
# Pick ONE of the three blocks below.
#
# Auth is optional: if EMAIL_USER is left empty the server connects without
# credentials, which is what local capture servers (Mailpit/MailHog) expect.
# If EMAIL_HOST is unset or still smtp.example.com, mail goes to an Ethereal
# test inbox and the API returns a previewUrl instead of delivering.

# --- (a) Mailpit — local capture. Nothing leaves the machine. ---
#   winget install axllent.mailpit     (or download the release binary)
#   mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025
#   inbox: http://localhost:8025
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="EnergySYS Service <no-reply@energysys.test>"

# --- (b) Mailtrap — hosted sandbox with a persistent, shareable inbox. ---
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=<mailtrap-username>
# EMAIL_PASSWORD=<mailtrap-password>
# EMAIL_FROM="EnergySYS Service <no-reply@energysys.test>"

# --- (c) Production SMTP — real delivery. ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=admin@your-domain.com
# EMAIL_PASSWORD=<app password / SMTP key>
# EMAIL_FROM="EnergySYS <admin@your-domain.com>"

# Optional: blind-copy every report to this address as well.
# REPORT_BCC=

# --- Uploads ---
MAX_IMAGES=8
MAX_IMAGE_MB=10

# --- Wind Farm Service Request (POST /api/service-request) ---
# Where wind-farm service requests are emailed (falls back to REPORT_TO).
SERVICE_REQUEST_TO=rds@esys.co.in
MAX_SERVICE_FILES=12
MAX_SERVICE_FILE_MB=25
